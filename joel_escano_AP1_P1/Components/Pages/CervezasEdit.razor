@inject NavigationManager navigationManager
@inject CervezasService cervezasService
@rendermode InteractiveServer

@page "/Cervezas/Edit/{IdCerveza:int}"


<PageTitle>Modificar Cervezas</PageTitle>


<div class="container">
    <EditForm Model="cerveza" FormName="FormularioRegistroCerveza" OnValidSubmit="Modificar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Creación de Cerveza</div>
            </div>


            <div class="card-body">
               
                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="cerveza.Marca" placeholder="Marca..." ></InputText>
                </div>
                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="cerveza.Nombre" placeholder="Nombre.."></InputText>
                </div>
                <div class="mb-3">
                    <InputNumber class="form-control" @bind-Value="cerveza.Puntuacion" placeholder="Puntuacion.."></InputNumber>
                </div>
                
                <div class="mb-3">
                    <InputDate class="form-control" @bind-Value="cerveza.Fecha" ></InputDate>
                </div>
            </div>

            <div class="card-footer justify-content-center">

                <a href="/Cervezas/Index" class="btn btn-secondary">Volver</a>
                <button type="button" class="btn btn-danger" @onclick="Eliminar"><span class="bi bi-trash"></span>Eliminar</button>
                <button type="submit" class="btn btn-primary">Modificar</button>
                <h3> @mensaje</h3>

            </div>
        </div>
    </EditForm>

</div>


@code {

    [Parameter]
    public int IdCerveza { get; set; }

    Cervezas cerveza { get; set; } = new Cervezas();
    public string mensaje { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var encontrada = await cervezasService.Buscar(IdCerveza);

        if (encontrada is null)
        {
            mensaje = "No se encontró la cerveza";
            return;
        }

        cerveza = encontrada;
    }


    public async Task Modificar()
    {
        var creado = await cervezasService.Modificar(cerveza);

        if (creado)
        {
            mensaje = "Se ha modificado con exito";
            navigationManager.NavigateTo("/Cervezas/Index");
        }
        else
        {
            mensaje = "No se ha podido crear";
            navigationManager.NavigateTo("/Cervezas/Index");
        }

    }

    public async Task Eliminar()
    {
        var eliminada = await cervezasService.Eliminar(cerveza.IdCerveza);
        if (eliminada)
        {
            mensaje = "Se ha podido eliminar con exito";
            await Task.Delay(1000);
            navigationManager.NavigateTo("/Cervezas/Index");
        }
        else
        {
            mensaje = "No se ha podido eliminar";
            await Task.Delay(1000);
        }
    }


}
