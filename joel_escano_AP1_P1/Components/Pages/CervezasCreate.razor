@inject NavigationManager navigationManager
@inject CervezasService cervezasService
@rendermode InteractiveServer

@page "/Cervezas/Create"
<PageTitle>Creación de Cerveza</PageTitle>

<div class="container">
    <EditForm Model="cerveza" FormName="FormularioRegistroCerveza" OnSubmit="Guardar">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Creación de Cerveza</div>
            </div>

            <div class="card-body">
               
                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="cerveza.Marca" placeholder="Marca..." ></InputText>
                </div>
                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="cerveza.Nombre" placeholder="Nombre.."></InputText>
                </div>
                <div class="mb-3">
                    <InputNumber class="form-control" @bind-Value="cerveza.Puntuacion" placeholder="Puntuacion.."></InputNumber>
                </div>
                
                <div class="mb-3">
                    <InputDate class="form-control" @bind-Value="cerveza.Fecha" ></InputDate>
                </div>

            </div>

            <div class="card-footer">
                <a href="/Cervezas/Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-primary"><span class="bi bi-trash"></span>Guardar</button>
                <h3> @mensaje</h3>
            </div>
        </div>
    </EditForm>

</div>



@code {
    public Cervezas cerveza { get; set; } = new Cervezas();

    public string mensaje { get; set; } = string.Empty;


    public async Task Guardar()
    {
        var creado = cervezasService.Insertar(cerveza);

        if(await creado)
        {
            mensaje = "Se ha creado exitosamente";
            navigationManager.NavigateTo("/Cervezas/Index");
        }
        else
        {
            mensaje = "No se ha podido crear";
        }

    }
}
