@inject CervezasService cervezasService
@inject NavigationManager navigationManager
@using Microsoft.AspNetCore.Components.QuickGrid

@rendermode InteractiveServer
@page "/Cervezas/Index"

<PageTitle>Registro de Cervezas</PageTitle>

<div class="container">
    <div class="card shadow-lg">

        <div class="card-header d-flex justify-content-between">
            <h5 class="card-title">Registro de Cervezas</h5>
            <a href="/Cervezas/Create" class="btn btn-primary">
                <span class="bi bi-plus-square-fill"></span> Crear
            </a>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-3">
                    <InputSelect class="form-control" @bind-Value="Filtro">
                        <option value="">Seleccione...</option>
                        <option value="nombre">Nombre</option>
                        <option value="marca">Marca</option>
                        <option value="puntuacion">Puntuación</option>
                    </InputSelect>
                </div>

                <div class="col-3">
                    <InputText class="form-control" @bind-Value="ValorBusqueda" />
                </div>

                <div class="col-2">
                    <InputDate class="form-control" @bind-Value="FechaDesde" />
                </div>

                <div class="col-2">
                    <InputDate class="form-control" @bind-Value="FechaHasta" />
                </div>

                <div class="col-2">
                    <button class="btn btn-primary w-100" @onclick="Buscar">
                        <span class="bi bi-search"></span> Buscar
                    </button>
                </div>

            </div>

            <QuickGrid Items="ListaCervezas.AsQueryable()" Pagination="paginationState" Class="table table-bordered table-hover">

                <PropertyColumn Property="c => c.IdCerveza" Title="ID" Sortable="true" />
                <PropertyColumn Property="c => c.Nombre" Title="Nombre" Sortable="true" />
                <PropertyColumn Property="c => c.Marca" Title="Marca" Sortable="true" />
                <PropertyColumn Property="c => c.Puntuacion" Title="Puntuación" Sortable="true" />
                <PropertyColumn Property="c => c.Fecha" Title="Fecha" Sortable="true" />

                <TemplateColumn Title="Acciones">
                    <a class="btn btn-sm btn-warning me-2" href="/Cervezas/Edit/@context.IdCerveza">Editar</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(context.IdCerveza)"> Eliminar </button>
                </TemplateColumn>

            </QuickGrid>

        </div>

        <div class="card-footer">
            <h6>Total de Cervezas: @ListaCervezas.Count</h6>
        </div>

    </div>
</div>

@code {

    public string Filtro { get; set; } = string.Empty;
    public string ValorBusqueda { get; set; } = string.Empty;

    public DateTime? FechaDesde { get; set; }
    public DateTime? FechaHasta { get; set; }

    public List<Cervezas> ListaCervezas { get; set; } = new();

    PaginationState paginationState = new() { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        ListaCervezas = await cervezasService.Listar(c => c.IdCerveza > 0);
    }

    public async Task Buscar()
    {
        ListaCervezas = await cervezasService.Listar(c =>
            (string.IsNullOrEmpty(Filtro) ||

            (Filtro == "nombre" && c.Nombre.Contains(ValorBusqueda)) ||

            (Filtro == "marca" && c.Marca.Contains(ValorBusqueda)) ||

            (Filtro == "puntuacion" && c.Puntuacion == int.Parse(ValorBusqueda)))

            &&

            (!FechaDesde.HasValue || c.Fecha.Date >= FechaDesde.Value.Date)
            &&

            (!FechaHasta.HasValue || c.Fecha.Date <= FechaHasta.Value.Date)
        );
    }

    private async Task Eliminar(int id)
    {
        var eliminado = await cervezasService.Eliminar(id);

        if (eliminado)
            await CargarDatos();
    }
}